# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5
# Mets true pour activer le raisonnement etendu (plus lent / plus cher)
ANTHROPIC_ENABLE_THINKING=false

# --- Base de donnees ---
# Sur Railway : utilise la variable DATABASE_URL du plugin Postgres.
# En local : laisse vide pour du SQLite (data/app.db).
DATABASE_URL=
DATABASE_PATH=data/app.db
DATA_DIR=data
SECRETS_DIR=data/runtime_secrets

# --- Dashboard (login) ---
DASHBOARD_EMAIL=admin@example.com
DASHBOARD_PASSWORD=change-me
# Multi-utilisateur (optionnel) : liste JSON de comptes autorises (partagent le meme dashboard).
# DASHBOARD_USERS_JSON=[{"email":"team@example.com","password":"..."}]
# Secret de signature des sessions (genere une longue chaine aleatoire)
SESSION_SECRET=change-me-in-production
# Cle de chiffrement des tokens Gmail en base (optionnel : sinon derivee de SESSION_SECRET).
# Genere : python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=
# Origine autorisee du front (URL du dashboard). * en dev.
# La 1re valeur sert aussi de destination de retour apres connexion Google d'un compte.
FRONTEND_ORIGIN=*

# --- Connexion de comptes Gmail depuis l'app (bouton "Ajouter") ---
# Client OAuth de type "Application Web" (Google Cloud Console). Colle le JSON complet
# ({"web":{...}}) ou sa version base64. Requis pour le bouton "Se connecter avec Google".
GOOGLE_OAUTH_CLIENT_JSON=
# GOOGLE_OAUTH_CLIENT_BASE64=
# URL de redirection autorisee a declarer dans Google Cloud (sinon deduite de la requete).
# Doit pointer vers l'API : https://<ton-api>/accounts/oauth/callback
OAUTH_REDIRECT_URI=

# --- Boucle worker ---
POLL_INTERVAL_SECONDS=60
# Le worker ne marque PAS les mails comme lus (deduplication en base). Un bouton
# "Marquer comme lu" est disponible dans le dashboard.
# Nombre max d'emails analyses par cycle (protege le cout Claude lors du rattrapage d'historique).
MAX_INGEST_PER_CYCLE=20
# Nombre max d'emails scannes (deja traites inclus) par cycle avant de s'arreter.
MAX_SCAN_PER_CYCLE=500
DEFAULT_REPLY_LANGUAGE=fr
DEFAULT_SIGNATURE=Samo Ferman

# --- Comptes email (multi-comptes) ---
# MAIL_ACCOUNTS_JSON est une liste JSON. Chaque compte accepte :
#   id, label, gmail_query, reply_language, signature,
#   credentials_json | credentials_base64 | credentials_path,
#   token_json | token_base64 | token_path
# Si credentials_* est absent, les identifiants OAuth partages (GMAIL_CREDENTIALS_*) sont reutilises.
# Exemple :
# MAIL_ACCOUNTS_JSON=[{"id":"pro","label":"PRO","gmail_query":"is:unread category:primary","token_base64":"..."},{"id":"perso","label":"PERSO","gmail_query":"is:unread","token_base64":"..."}]
MAIL_ACCOUNTS_JSON=
MAIL_ACCOUNTS_BASE64=

# --- Compte unique (mode legacy, utilise si MAIL_ACCOUNTS_* est vide) ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
# Filtre Gmail. Par defaut on supervise toute la boite (historique + futurs).
# Pour ne prendre que les nouveaux non lus : is:unread category:primary
# Pour limiter l'historique : category:primary newer_than:30d
GMAIL_QUERY=category:primary
GMAIL_CREDENTIALS_JSON=
GMAIL_CREDENTIALS_BASE64=
GMAIL_TOKEN_JSON=
GMAIL_TOKEN_BASE64=

# --- Deploiement ---
# ROLE=worker (ingestion) ou ROLE=api (dashboard). Un service Railway par role.
ROLE=worker
